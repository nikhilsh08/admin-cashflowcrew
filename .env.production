# The website (API) this admin panel talks to, used by `vite build` when the
# host does not set VITE_SERVER_URL itself. A value set in the host's
# dashboard (Render, Vercel) takes priority over this file.
# Not a secret: it is the public address of the site. No slash at the end.
VITE_SERVER_URL=https://cashflowcrew-v10.onrender.com
